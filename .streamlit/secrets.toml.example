# Copy this file to secrets.toml and fill in what you use. All are optional.

# Google Sheet shared with n8n (the long ID in the sheet's URL).
# Tabs: daily_sales and ai_reports. Share as "Anyone with the link can view".
GSHEET_ID = ""

# Production URL of the "Run from dashboard" Webhook node in n8n.
N8N_WEBHOOK_URL = ""

# Enables "Generate with AI" on the AI report page. Set ONE of these (OpenAI is used if both are set).
OPENAI_API_KEY = ""
# OPENAI_MODEL = "gpt-4o-mini"   # optional, any chat model your account can use
ANTHROPIC_API_KEY = ""
